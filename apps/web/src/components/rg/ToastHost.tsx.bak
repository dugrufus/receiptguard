"use client";
import * as React from "react";
import { t } from "../../rg/i18n/t";

type Toast = { id: string; message: string; countdownSec?: number };
type Props = { toasts?: Toast[]; children?: React.ReactNode };

export default function ToastHost({ toasts = [], children }: Props) {
  // [RG:BLOCK UI.TOAST JSX START]
  return (
    <div className="fixed top-2 right-2 space-y-2 z-50" role="region" aria-live="polite" aria-label={t("settings.sections.notifications")}>
      {toasts.map(ti => (
        <div key={ti.id} className="rounded-md border bg-white px-3 py-2 shadow">
          <div className="text-sm">{ti.message}</div>
          {typeof ti.countdownSec === "number" && (
            <div className="text-xs opacity-70">{ti.countdownSec}s</div>
          )}
        </div>
      ))}
      {children}
    </div>
  );
  // [RG:BLOCK UI.TOAST JSX END]
}