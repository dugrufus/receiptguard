import { t } from "../../rg/i18n/t";

type Props = { percent: number; days: number; size?: number; stroke?: number };

export default function ProgressRing({ percent, days, size = 44, stroke = 6 }: Props) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  const dash = Math.max(0, Math.min(100, percent)) / 100 * c;
  const rest = c - dash;
  const label = t("ring.daysLeftShort", { days });
  // [RG:BLOCK UI.RING SVG START]
  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} role="img" aria-label={label}>
      <circle cx={size/2} cy={size/2} r={r} stroke="currentColor" strokeOpacity="0.15" strokeWidth={stroke} fill="none" />
      <circle
        cx={size/2} cy={size/2} r={r}
        stroke="currentColor" strokeWidth={stroke} fill="none"
        strokeDasharray={`${dash} ${rest}`}
        strokeLinecap="round"
        transform={`rotate(-90 ${size/2} ${size/2})`}
      />
      <text x="50%" y="50%" dominantBaseline="middle" textAnchor="middle" fontSize="12">{label}</text>
    </svg>
  );
  // [RG:BLOCK UI.RING SVG END]
}